# 실제 값을 채운 뒤 파일명을 .env 로 바꾸세요. (현재 스켈레톤은 MOCK_MODE=1 이라 없어도 동작)
MOCK_MODE=1

# LLM (벤더 중립 — 값은 env 로 주입. 코드에 벤더명·모델명을 박지 않는다)
# 2026-09-13 결정: Bedrock은 쓰지 않는다. [3-C]·[5] 문장 생성은 OpenAI만 쓴다.
# 실제 호출하려면 셋이 다 필요하다: MOCK_MODE=0 · LLM_PROVIDER=openai · LLM_MODEL · OPENAI_API_KEY
LLM_PROVIDER=mock
# 사용할 모델 id (예: gpt-4o-mini). 콘솔에서 실제 쓸 모델을 확인해 넣는다
LLM_MODEL=gpt-4o-mini
# OpenAI API 키. .env 는 .gitignore 이므로 이 예시 파일에는 실제 값을 절대 넣지 않는다
OPENAI_API_KEY=
# 조건 대화 에이전트 (Strands Agents SDK, src/agent/conditions_agent.py). 1 이면 조건 대화의 자유 텍스트를
# LLM 도구 호출로 반영한다 (위 셋이 다 있어야 실제로 켜진다). 기본 0 — 계약 §D-3 합의 전 opt-in.
CONDITIONS_AGENT=0
# 결과 화면 대화 에이전트 (Strands, src/agent/result_agent.py). 1 이면 결과 화면 입력칸의 자유 텍스트를
# LLM 도구 호출(후보 조회·교체·담기/빼기·수량·시점·근거 설명)로 처리한다. 기본 0 — 규칙(슬롯+저렴/좋은) 경로.
RESULT_AGENT=0
# 달러 입력("$1,500")을 원화 예산으로 바꾸는 고정 환율 (실시간 아님). 저장·계산은 원화, 사용자가 달러로 말했으면 답변·표시는 달러 먼저
USD_KRW_RATE=1400
# 아래 둘은 옛 pgvector RAG(Bedrock Titan) 변수다 — rag 스키마가 0011에서 삭제돼 라이브 경로는 읽지 않는다.
# [3-C]·[5]의 OpenAI 호출과 무관하니 비워 둔다.
LLM_REGION=
EMBEDDING_MODEL=

# RAG (현재 살아 있는 두 경로)
# 1) "구매 전 확인" 부품 가이드 (src/rag/care_guides.py) — data/pc_care_guides.json 을 프로세스 시작 시
#    인메모리로 임베딩. MOCK_MODE=1 이면 해시 임베딩, 0 이면 OPENAI_API_KEY 로 아래 모델 호출.
# CARE_GUIDE_EMBEDDING_MODEL=text-embedding-3-small
# 2) 유아 설명서 검색 제공자 (src/rag/provider.py) — 비우면 "미설정"(적합성 unknown, 자동 선택 금지).
#    local-file 은 PostgreSQL 밖 파일 인덱스. scripts/rag_manual.py ingest --provider local-file 로 게시한다.
# BABY_SEARCH_PROVIDER=local-file
# BABY_SEARCH_STORAGE_ROOT=.baby-search-index
# 옛 pgvector 경로 전용(tests/test_rag*.py, 삭제된 스키마 대상): RAG_EMBEDDING_PROVIDER · RAG_STORAGE_ROOT · RAG_TEST_DATABASE_URL

# PostgreSQL + pgvector (2번 작업에서 사용)
# DATABASE_URL=postgresql://truefit:truefit@localhost:5432/truefit

# 이메일+비밀번호 로그인 (src/auth, src/services/auth_service.py)
# 운영에서는 반드시 값을 바꾸세요 — 기본값을 그대로 쓰면 토큰 위조가 가능합니다.
JWT_SECRET=dev-only-change-me
# https로 서빙할 때만 1 (평문 http 개발 환경에서 Secure 쿠키는 브라우저가 거부합니다)
COOKIE_SECURE=0
