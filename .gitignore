# ── 환경변수 / 비밀키 (절대 커밋 금지) ──
.env
*.env
!.env.example
# Nexar 액세스 토큰 캐시 (scripts/nexar_snapshot.py 가 저장소 루트에 만든다)
.nexar_token.json

# ── 런타임에 생성되는 데이터 (소스코드 아님, 커밋 대상 아님) ──
data/*
# 스냅샷 카탈로그만 예외 — 소스 취급(CATALOG_SOURCE=snapshot 이 읽는다)
!data/nexar_snapshot.json
# 부품 마스터를 편 것 — 우리가 손으로 채운 스펙이라 커밋한다
!data/parts.json
# 리뷰 실사 결과 — 상품 식별자와 건수뿐, 리뷰 원문이 아니다
!data/review_probe.json
# 리뷰 파생 지표 — 건수·분포·출처만. **원문은 여기 없다**
!data/reviews_snapshot.json
# 리뷰 원문과 클렌징 결과는 커밋하지 않는다 (2026-09-08 방침).
# data/* 규칙에 이미 걸리지만, 실수로 예외를 추가하는 것을 막으려고 다시 적는다.
data/reviews_raw/
data/reviews_clean/
data/parts_list.xlsx
reports/
*.db
*.sqlite
*.sqlite3
*.jsonl

# ── Python ──
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── 가상환경 ──
.venv/
venv/
env/
ENV/

# ── IDE / 에디터 ──
.vscode/
.idea/
*.swp
*.swo

# ── OS ──
.DS_Store
Thumbs.db
desktop.ini

# ── 로그 ──
*.log
# 공유용 페이지 산출물 (docs/공유문서/build.py 가 만든다)
docs/공유문서/build/
