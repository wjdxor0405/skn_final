# ── Python ──
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
*.so

# ── 가상환경 ──
.venv/
venv/
env/
ENV/
# 잘못 생성된 디렉토리 (쉘 오류로 만들어진 '&&' 폴더 등) — git init 전에 삭제 권장
&&/

# ── 환경변수 / 시크릿 ──
.env
.env.*
!.env.example

# ── 테스트 / 타입 / 린트 캐시 ──
.pytest_cache/
node_modules/
.rag-files/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# ── DB (로컬) ──
db/pgdata/
db/*.log
pg.log
*.dump
*.sql.gz

# ── 크롤러 캐시 ──
scripts/.cache_specs/
scripts/.render_cache/

# ── IDE / 에디터 ──
.idea/
.vscode/
*.swp
*.swo
*~

# ── OS ──
.DS_Store
Thumbs.db
desktop.ini

# ── 로그 / 임시 ──
*.log
logs/
tmp/
*.tmp

