# 이 파일을 복사해서 .env 로 이름을 바꾸고, 실제 값을 채워넣으세요.
# .env 파일 자체는 절대 git에 커밋하지 마세요 (.gitignore에 추가 권장).

# OpenAI API 키 (NEGOTIATOR_MODE=llm 일 때만 필요)
OPENAI_API_KEY=sk-여기에-발급받은-키-입력

# 협상 에이전트 모드: rule(기본값, 무료) 또는 llm(OpenAI 사용)
NEGOTIATOR_MODE=rule

# 협상에 사용할 OpenAI 모델 (NEGOTIATOR_MODE=llm 일 때만 사용, 기본값: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini
\n
# 카탈로그 출처: snapshot(기본, 커밋된 Nexar 실데이터) / sqlite(화면에서 직접 등록).
# 비워두면 snapshot 이라 키 없이 그대로 돕니다.
CATALOG_SOURCE=snapshot

# ── 납품 가능성 검증 (app/feasibility.py) ──
# 부족분 자동 조달 시 협상 상한가 = 적격 공급처 최저가 × (1 + 이 값)
PROCURE_CAP_MARGIN=0.05

# ── 아래 3개는 CATALOG_SOURCE=snapshot 일 때만 쓰입니다 ──
# 커밋된 Nexar(Octopart) 응답 원본. API 키 없이 실데이터로 돌리기 위한 경로입니다.
SNAPSHOT_PATH=data/nexar_snapshot.json
# 셀러의 '최저 수용가'는 어떤 공개 데이터에도 없어서 제시가의 이 비율로 가정합니다.
# 스냅샷 파일에 굽지 않고 읽는 시점에 만들므로, 이 값만 바꾸면 재조회 없이 바뀝니다.
SNAPSHOT_FLOOR_RATIO=0.90
# 스키마(offer_price/floor_price)가 정수라 단가를 이 통화로 맞춥니다.
SNAPSHOT_CURRENCY=KRW
# 폴백 환율. 조회할 때 통화를 넘겼으면 응답에 API가 계산한 환산값이 실려 오고
# 그쪽이 우선합니다. 이 표는 환산값이 없는 행에만 쓰이고, 둘 다 없으면 버립니다.
SNAPSHOT_FX=USD=1400
# 인가 유통사(isAuthorized)만 협상 후보로 볼지. 비인가 유통사는 실측상 최저가가
# 인가 유통사의 1/4.4(중앙값)이고 극단은 기가비트 PHY 37원처럼 설명이 안 됩니다.
# 스냅샷 파일에는 전부 남아 있으니 false 로 두면 즉시 원래대로 돌아옵니다.
SNAPSHOT_AUTHORIZED_ONLY=true
# 재고에서 바로 나가는 물량의 납기. factoryLeadDays 는 공장 재생산 시간이라
# 재고 출하에는 적용되지 않습니다. 0 은 "공장 리드타임 제약이 없다"는 뜻입니다.
SNAPSHOT_STOCK_LEAD_DAYS=0

# ── Nexar(Octopart) 조회 (scripts/nexar_snapshot.py 에서만 사용) ──
# 스냅샷을 다시 뜰 때만 필요합니다. 커밋된 data/nexar_snapshot.json 으로 앱을
# 돌리는 데는 키가 없어도 됩니다 — 심사위원이 실행할 수 있어야 하므로 그렇게 설계했습니다.
# https://nexar.com 에서 애플리케이션을 만들고 supply.domain 스코프를 받으세요.
NEXAR_CLIENT_ID=
NEXAR_CLIENT_SECRET=
