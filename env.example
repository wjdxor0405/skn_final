# 이 파일을 복사해서 .env 로 이름을 바꾸고, 실제 값을 채워넣으세요.
# .env 파일 자체는 절대 git에 커밋하지 마세요 (.gitignore에 추가 권장).

# OpenAI API 키 (NEGOTIATOR_MODE=llm 일 때만 필요)
OPENAI_API_KEY=sk-여기에-발급받은-키-입력

# 협상 에이전트 모드: rule(기본값, 무료) 또는 llm(OpenAI 사용)
NEGOTIATOR_MODE=rule

# 협상에 사용할 OpenAI 모델 (NEGOTIATOR_MODE=llm 일 때만 사용, 기본값: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini
\n
# ── Odoo 연동 (scripts/seed_odoo_demo.py, 추후 odoo_client) ──
# 로컬 개발 기본값이 코드에 박혀 있으므로, 로컬에서 그대로 쓸 거면 비워둬도 됩니다.
ODOO_URL=http://localhost:8069
ODOO_DB=odoo19
ODOO_USER=admin
ODOO_PASSWORD=admin

# 카탈로그 출처: sqlite(기본, 화면에서 직접 등록) 또는 odoo(공급처 단가표를 읽음)
CATALOG_SOURCE=sqlite

# ── 아래 3개는 CATALOG_SOURCE=odoo 일 때만 쓰입니다 ──
# 공급처의 '최저 수용가'는 Odoo에 없는 값이라 제시가의 이 비율로 가정합니다 (협상 여지)
ODOO_FLOOR_RATIO=0.90
# 공급처의 공급능력도 Odoo에 없어서 사실상 무제한으로 둡니다 (실질 제약은 MOQ)
ODOO_VENDOR_CAPACITY=1000000
# 품목 목록을 특정 접두사로 좁히고 싶을 때 (예: RM- 로 원자재만). 비우면 전체
# 화면의 발주서 링크에 쓸 주소. 브라우저에서 접근 가능한 주소로 (비우면 ODOO_URL 사용).
# 다른 기기에서 접속한다면 localhost가 아니라 그 기기가 닿는 주소여야 합니다.
ODOO_PUBLIC_URL=

ODOO_ITEM_PREFIX=

# ── 회사별 Odoo 인스턴스 (선택) ──
# 목표 구조는 "회사마다 자기 Odoo"입니다. 위 ODOO_* 는 우리 회사이고,
# 다른 회사를 추가하려면 ODOO_<이름>_URL / _DB / _USER / _PASSWORD 를 넣으세요.
# 지정하지 않은 항목은 우리 회사 설정을 물려받습니다.
#
# 같은 서버의 다른 DB를 가리켜도 됩니다 — Odoo는 한 프로세스가 여러 DB를 호스팅하므로
# URL은 그대로 두고 DB만 다르게 주는 구성이 가장 쌉니다.
#
#   ODOO_HANBIT_DB=odoo19_hanbit
#
# 코드에서는 get_client("hanbit") 으로 꺼내 씁니다. 쓰지 않으면 연결도 열리지 않습니다.

# ── 납품 가능성 검증 (app/feasibility.py) ──
# Odoo에 "하루 몇 개 만들 수 있나"에 해당하는 단순한 필드가 없어서 여기서 정합니다.
# 도메인에 따라 크게 다릅니다. 기본 10/일 = 50/주 (GPU 서버랙 조립 기준)
PRODUCTION_CAPACITY_PER_DAY=10
# 부족분 자동 조달 시 협상 상한가 = 적격 공급처 최저가 × (1 + 이 값)
PROCURE_CAP_MARGIN=0.05

# ── 아래 3개는 CATALOG_SOURCE=snapshot 일 때만 쓰입니다 ──
# 커밋된 Nexar(Octopart) 응답 원본. API 키 없이 실데이터로 돌리기 위한 경로입니다.
SNAPSHOT_PATH=data/nexar_snapshot.json
# 셀러의 '최저 수용가'는 어떤 공개 데이터에도 없어서 제시가의 이 비율로 가정합니다.
# 스냅샷 파일에 굽지 않고 읽는 시점에 만들므로, 이 값만 바꾸면 재조회 없이 바뀝니다.
SNAPSHOT_FLOOR_RATIO=0.90
# 원본 단가는 실수 달러인데 스키마(offer_price/floor_price)는 정수라 환산이 필요합니다.
# "USD=1400,EUR=1520" 형식. 표에 없는 통화의 행은 틀린 환율로 넣지 않고 버립니다.
SNAPSHOT_FX=USD=1400
